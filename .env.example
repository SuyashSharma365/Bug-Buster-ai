# LLM provider: groq, hf, or anthropic
DOCMIND_LLM_PROVIDER=groq

# API providers
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local Hugging Face generation model
DOCMIND_HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Embedding/vector storage
DOCMIND_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCMIND_CHROMA_DIR=./storage/chroma
DOCMIND_COLLECTION=docmind_documents
DOCMIND_DATA_DIR=./data
DOCMIND_MCP_MODULE=mcp_server.docs_server
